# TripSync - Backend Environment Variables Configuration Template
# Copy this file to '.env' and fill in your actual production settings.
# NEVER commit the '.env' file with real production credentials to version control.

# JWT Configuration Security
# Generate a secure random 256-bit (32 bytes) key. e.g. using 'openssl rand -base64 32'
JWT_SECRET=TripsyncUltraSecureJwtSigningKeyForProduction2026RealtimeExpensePlatformSecurityKey

# Spring Boot Active Profile
# Use 'dev' for local H2 database, 'prod' for production PostgreSQL database
SPRING_PROFILES_ACTIVE=prod

# Production PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripsync
DB_USER=postgres
DB_PASS=4114

# Alternatively, Render / Heroku injects the full URL directly:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripsync?sslmode=require

# CORS & WebSocket Allowed Origins (comma-separated for multiple domains)
# Restrict this to your frontend URL in production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
