# TripSync - Backend Environment Variables Configuration Template

# JWT Secret Key
JWT_SECRET=your_jwt_secret_here

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL JDBC URL
DATABASE_URL=jdbc:postgresql://your-host/your-db?user=your-user&password=your-password&sslmode=require

# Allowed Frontend Origins
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173